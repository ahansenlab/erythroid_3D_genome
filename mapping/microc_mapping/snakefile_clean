os.environ['TMPDIR'] = YOUR_TMP_DIR
sample_map_df = YOUR_SAMPLES_PATH_FILE 

sample_map_df.set_index("sample_id", inplace = True)

def find_fastqs(wildcards):
    sample_id = f"{wildcards.sample}_{wildcards.rep}_{wildcards.lane}"
    return {
        "fastq_r1": sample_map_df.at[sample_id, "fastq_r1"],
        "fastq_r2": sample_map_df.at[sample_id, "fastq_r2"],
    }

## CHANGE path to output folder ##
base_path="/mnt/coldstorage/Varshmallow/Adipose_Blood_Genomics/"

rule bwa_align:
    output: 
        pairs=base_path + "aligned_files/{sample}_{rep}_{lane}.pairs.gz",
        stats=base_path + "aligned_files/{sample}_{rep}_{lane}.stats.txt"
    input:
        # change path to genome and/or chromsizes
        unpack(find_fastqs),
        genome="/mnt/coldstorage/Varshmallow/hg38_analysisSet/hg38.analysisSet.fa.gz",
        chromsizes="/mnt/md0/DataRepository/chromsizes/hg38/hg38.sorted.chrom.sizes"
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    params: 
        assembly="hg38"
    resources:
        cpus_per_task=4,
        bwa_align=1
    threads: 4
    shell:
        # the :q for the fastq inputs is necessary because of spaces in our fastq paths (if using fastqs on dropbox)
        "bwa-mem2 mem -t {threads} -SP {input.genome} {input.fastq_r1:q} {input.fastq_r2:q} "
        "| pairtools parse2 --add-columns mapq -c {input.chromsizes} --expand --report-position outer "
        "--assembly {params.assembly} --min-mapq 30 --drop-sam --max-insert-size 150 --output-stats {output.stats} "
        "--nproc-in {threads} -o {output.pairs}"

def find_stats_files(wildcards):
    all_lanes = list(sample_map_df[
        (sample_map_df["sample"] == wildcards.sample) &
        (sample_map_df["rep"] == wildcards.rep)
    ]['lane'])

    return expand(
        rules.bwa_align.output.stats,
        sample=wildcards.sample, 
        rep=wildcards.rep,
        lane=all_lanes
    )

rule generate_stats_files_per_rep:
    output:
        stats_per_rep="pairtools_stats/{sample}_{rep}_stats.txt"
    input:
        stats_per_lane=find_stats_files
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 3
    resources:
        mem_mb=4000
    shell:
        "pairtools stats --merge "
        "--nproc-in {threads} "
        "-o {output.stats_per_rep} "
        "{input.stats_per_lane}"

def find_rep_merged_stats_files(wildcards):
    needed_samples = sample_map_df[
        sample_map_df["sample"] == wildcards.sample
    ]
    needed_files = []
    for row in needed_samples.itertuples():
        needed_files.append(
            rules.generate_stats_files_per_rep.output.stats_per_rep.format(
                sample=wildcards.sample,
                rep=row.rep
            )
        )
    return list(set((needed_files)))

rule generate_stats_files:
    output:
        stats="pairtools_stats/{sample}_stats.txt"
    input:
        stats_per_rep=find_rep_merged_stats_files
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 3
    resources:
        mem_mb=4000
    shell:
        "pairtools stats --merge "
        "--nproc-in {threads} "
        "-o {output.stats} "
        "{input.stats_per_rep}"

rule sort_per_lane:
    output:
        sorted_pairs_lane=base_path+"aligned_files/{sample}_{rep}_{lane}.pairs.sorted.gz"
    input:
        pairs=rules.bwa_align.output.pairs
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 8
    resources:
        mem_mb=200000
    shell:
        "pairtools sort --tmpdir /mnt/coldstorage/Varshmallow/Adipose_Blood_Genomics/ --nproc {threads} "
        "-o {output.sorted_pairs_lane} {input.pairs}"

def find_files_for_rep_merge(wildcards):
    all_lanes = list(sample_map_df[
        (sample_map_df["sample"] == wildcards.sample) &
        (sample_map_df["rep"] == wildcards.rep)
    ]['lane'])

    return expand(
        rules.sort_per_lane.output.sorted_pairs_lane,
        sample=wildcards.sample, 
        rep=wildcards.rep,
        lane=all_lanes
    )

rule merge_per_rep:
    output:
        merged=base_path + "merged_per_rep/{sample}_{rep}_merged.nodups.pairs.gz",
        stats=base_path + "merged_per_rep/{sample}_{rep}_merged.dedup.stats.txt"
    input:
        lane_merged_files=find_files_for_rep_merge
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 8
    resources:
        mem_mb=200000,
        pairtools_merge=1
    shell:
        "pairtools merge --tmpdir /mnt/coldstorage/Varshmallow/Adipose_Blood_Genomics/ --nproc {threads} "
         "--max-nmerge 4 "
         "{input.lane_merged_files} "
         "| pairtools dedup -p {threads} --max-mismatch 1 "
         "--mark-dups --output {output.merged} "
         "--output-stats {output.stats}"

def find_rep_merged_files(wildcards):
    needed_samples = sample_map_df[
        sample_map_df["sample"] == wildcards.sample
    ]
    needed_files = []
    for row in needed_samples.itertuples():
        needed_files.append(
            rules.merge_per_rep.output.merged.format(
                sample=wildcards.sample,
                rep=row.rep
            )
        )
    return list(set((needed_files)))

rule merge_per_sample:
    output:
        mega=base_path+"full_merged_files/{sample}_microc.nodups.pairs.gz"
    input:
        rep_merged_files=find_rep_merged_files
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 8
    resources:
        mem_mb=200000,
        pairtools_merge=1
    shell:
        "pairtools merge --tmpdir /mnt/coldstorage/Varshmallow/Adipose_Blood_Genomics/ --nproc {threads} "
        "--output {output.mega} "
        "{input.rep_merged_files}"

rule sort_per_sample:
    output:
        sorted_pairs="full_merged_files/{sample}_microc.nodups.sorted.pairs.gz"
    input:
        mega=rules.merge_per_sample.output.mega
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 8
    resources:
        mem_mb=200000
    shell:
        "pairtools sort --tmpdir /mnt/coldstorage/Varshmallow/Adipose_Blood_Genomics/ --nproc {threads} "
        "-o {output.sorted_pairs} {input.mega}"

rule pairix_indexing:
    output:
        index="full_merged_files/{sample}_microc.nodups.sorted.pairs.gz.px2"
    input:
        sorted_pairs=rules.sort_per_sample.output.sorted_pairs
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    resources:
        mem_mb=4000
    shell:
        "pairix {input.sorted_pairs}"

rule cooler_cload:
    output:
        cool="full_merged_files/{sample}_microc.50.cool"
    input:
        merged=rules.sort_per_sample.output.sorted_pairs,
        idx=rules.pairix_indexing.output.index,
        chromsizes="/mnt/md0/DataRepository/chromsizes/hg38/hg38.sorted.chrom.sizes"
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 3
    resources:
        mem_mb=200000
    params:
        assembly="hg38"
    shell:
        "bgzip -cd -@ {threads} "
        "{input.merged} "
        "| cooler cload pairs -c1 2 -p1 3 -c2 4 -p2 5 "
        "--assembly {params.assembly} "
        "--temp-dir /mnt/coldstorage/Varshmallow/Adipose_Blood_Genomics/ {input.chromsizes}:50 - "
        "{output.cool}"

rule zoomify:
    output:
        mcool="full_merged_files/{sample}_microc.50.mcool"
    input:
        cool=rules.cooler_cload.output.cool
    conda:
        "/mnt/md0/varshini/src/rcmc.yml"
    threads: 8
    resources:
        mem_mb=200000
    params:
        res="10000000,5000000,2500000,1000000,500000,250000,100000,50000,25000,10000,6400,5000,3200,2000,1600,1000,800,500,400,300,250,200,150,100,50"
    shell:
        "cooler zoomify --nproc {threads} "
        "--balance --out {output.mcool} "
        "--resolutions {params.res} "
        "{input.cool}"

